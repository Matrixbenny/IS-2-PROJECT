PORT=5000
MONGO_URI=mongodb://localhost:27017/kenya_watch
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
# Admin login identity. Must NOT be the developer/sender mailbox below - that
# address is reserved and can never be a user account. Create it out of band
# with `node scripts/bootstrap-admin.js "Name" "admin@your-domain"`.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD_HASH=
FRONTEND_ORIGIN=http://localhost:3000
# Where the Agency Case Portal is served from (used in agency password-reset emails).
AGENCY_PORTAL_ORIGIN=http://localhost:5000
NODE_ENV=development
# Optional custom path; by default the reviewer model suggestion reads
# ml/artifacts/category_model.runtime.json after running the ML training command.
# ML_CATEGORY_MODEL_PATH=

# Mail delivery. SMTP_HOST is required for production email delivery.
# SMTP_USER + MAIL_FROM are the developer inbox that sends OTP/notification
# email; that address is automatically reserved and cannot be registered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=
MAIL_FROM="Kenya Watch <your-account@gmail.com>"
# Replies to transactional mail are directed here (defaults to MAIL_FROM).
MAIL_REPLY_TO=your-account@gmail.com
# Extra addresses that must never be registered (comma separated).
# officialbillionaire.ke@gmail.com is always reserved, even if not listed here.
RESERVED_EMAILS=

# ---------------------------------------------------------------------------
# ZERO-COST PHONE ALERTS (recommended). Web Push alerts shown by the phone's
# own OS. No airtime, no SIM credit, no SMS gateway, no per-message charge -
# works even on a phone with zero airtime, over any internet/Wi-Fi connection.
# Generate a key pair once with:  node scripts/generate-vapid-keys.js
# Note: service workers require HTTPS in production (localhost is exempt).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# ---------------------------------------------------------------------------
#
# SMS notifications (optional, costs airtime or credits). Leave every provider
# blank to disable SMS. NOTE: an Android gateway sends with the SIM's outgoing
# airtime, so a SIM with zero credit cannot send anything.
# ---------------------------------------------------------------------------
# Providers are tried in order; list several comma separated in SMS_PROVIDERS.
#
# 1. Android gateway app (https://sms-gate.app) on a phone with a SIM.
#    No API subscription, but each SMS is paid for by that SIM's airtime.
#      SMS_PROVIDER=android_gateway
#      SMS_GATEWAY_URL=http://192.168.1.20:8080/send
#      SMS_GATEWAY_TOKEN=<username:password shown on the app's Home screen>
#
# 2. Free hosted open-source gateway (textbee.dev): register a phone, copy the
#    device id and API key.
#      SMS_PROVIDER=textbee
#      SMS_TEXTBEE_API_KEY=<key>
#      SMS_TEXTBEE_DEVICE_ID=<device id>
#
# 3. Africa's Talking sandbox: free, but messages only appear in their
#    simulator (never on a real handset). Real delivery is billed per SMS.
#      SMS_PROVIDER=africastalking
#      SMS_USERNAME=sandbox
#      SMS_API_KEY=<sandbox api key>
#
# 4. Generic Kenyan HTTP bulk-SMS gateway (only if you already have access):
#      SMS_PROVIDER=bulk_sms
#      SMS_BULK_SMS_URL=https://example.co.ke/api/services/sendsms/
#      SMS_BULK_SMS_KEY=<api key>
#      SMS_BULK_SMS_SENDER=<optional sender id>
#
# Fallback chain example: SMS_PROVIDERS=android_gateway,textbee,africastalking
SMS_PROVIDER=
SMS_PROVIDERS=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_TEXTBEE_API_KEY=
SMS_TEXTBEE_DEVICE_ID=
SMS_BULK_SMS_URL=
SMS_BULK_SMS_KEY=
SMS_BULK_SMS_SENDER=
# Paid fallback, only if you ever use a Twilio trial/account.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# Development only: logs the disposable Ethereal message-preview URL, which
# contains a password-reset link. Never enable this in production or shared logs.
MAIL_LOG_PREVIEW_URL=false
