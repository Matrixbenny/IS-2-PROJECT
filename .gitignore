# Ignore everything by default - only the story doc + actual app code are tracked.
/*
!/.gitignore
!/Docs/
/Docs/*
!/Docs/my IS story.md
!/backend/
!/frontend/
!/agency-portal/
!/ml/
!/README.md

# ...except build artifacts, dependencies and secrets inside those app folders.
node_modules/
__pycache__/
*.py[cod]
build/
dist/
.env
backend/data/
backend/cookies.txt
backend/*.log
frontend/*.log
ml/data/raw/
ml/data/approved/
ml/data/processed/
ml/artifacts/
ml/models/
ml/reports/
